{
  "name": "srilankatoursdriver-backend",
  "version": "1.0.0",
  "description": "Sri Lanka Tours Driver REST API (Express + MongoDB + Cloudinary)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "verify:cloudinary": "tsx src/scripts/verify-cloudinary.ts",
    "migration:discover": "tsx migration/src/discover.ts",
    "migration:zip:extract": "tsx migration/zip/scripts/extract.ts ../migrate",
    "migration:zip:import": "tsx migration/zip/scripts/import.ts",
    "migration:zip:homepage": "tsx migration/zip/scripts/homepage.ts",
    "migration:zip:reviews-about": "tsx migration/zip/scripts/reviews-about.ts",
    "migration:zip:about-team": "tsx migration/zip/scripts/about-team.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "slugify": "^1.6.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true
  }
}
