# =============================================================================
# Sri Lanka Tours Driver – backend environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# This file must only ever contain placeholders – no real credentials.
# Validated at startup by src/config/env.ts (the API refuses to boot if invalid).
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Port the Express API listens on
PORT=5000
# Number of reverse proxies in front of the API (e.g. 1 behind Nginx/Render/Railway).
# Needed for correct client IPs in rate limiting. 0 = not behind a proxy.
TRUST_PROXY=0
# Max login/refresh attempts per IP per 15 minutes (raise only for automated E2E runs)
AUTH_RATE_LIMIT=20
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Database ----------------------------------------------------------------
# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/srilankatoursdriver
# Optional, tests only: use an existing MongoDB server instead of the in-memory one
# MONGODB_TEST_URI=mongodb://localhost:27017

# ---- Authentication (JWT) ----------------------------------------------------
# Required. Min 32 characters each, and the two MUST be different.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-long-random-secret>
# Access token lifetime (e.g. 15m, 1h)
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=7

# ---- Auth cookies ------------------------------------------------------------
# Leave empty for host-only cookies (recommended). If set, a bare domain only,
# e.g. .example.com – no scheme, port or path.
COOKIE_DOMAIN=
# lax    – frontend & API share a registrable domain (recommended)
# strict – same as lax but stricter cross-site navigation rules
# none   – frontend & API on different domains (requires HTTPS / Secure cookies)
COOKIE_SAMESITE=lax
# auto  – Secure in production and whenever COOKIE_SAMESITE=none (recommended)
# true/false – force it (false is rejected in production)
COOKIE_SECURE=auto

# ---- Customer accounts: Sign in with Google (optional) ----------------------
# OAuth 2.0 Web client ID from Google Cloud console → APIs & Services → Credentials.
# Add the website origin(s) under "Authorized JavaScript origins".
# Must equal NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend. Empty = Google sign-in disabled.
GOOGLE_CLIENT_ID=

# ---- Prices --------------------------------------------------------------------
# Public prices are shown in USD, converted from the currency entered in Admin using a live
# daily exchange rate (open.er-api.com). This LKR-per-USD rate is used only if that feed is down.
FALLBACK_LKR_PER_USD=300

# ---- Cloudinary (media storage) ----------------------------------------------
# From the Cloudinary console → Settings → API Keys. Required for media uploads.
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>
# Top-level folder all uploads are stored under
CLOUDINARY_ROOT_FOLDER=srilankatoursdriver

# ---- Frontend / CORS ---------------------------------------------------------
# Public URL of the Next.js site (allowed CORS origin + on-demand revalidation target)
FRONTEND_URL=http://localhost:3000
# Optional extra allowed origins, comma-separated, origins only (no paths)
# e.g. https://www.example.com,https://admin.example.com
CORS_ORIGINS=
# Shared secret for on-demand page revalidation.
# Must equal REVALIDATE_SECRET in the frontend environment.
REVALIDATE_SECRET=<generate-a-long-random-secret>

# ---- Email (SMTP, optional) --------------------------------------------------
# Used for booking / enquiry / contact notifications. Leave empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=<your-smtp-username>
SMTP_PASSWORD=<your-smtp-password>
SMTP_FROM="Sri Lanka Tours Driver <no-reply@example.com>"
# Inbox that receives admin notifications
NOTIFY_EMAIL=

# ---- Machine translation (optional) ------------------------------------------
# deepl | google | libretranslate | none (manual editing only)
TRANSLATION_PROVIDER=none
TRANSLATION_API_KEY=<your-translation-api-key>
# Required for self-hosted LibreTranslate; optional otherwise
TRANSLATION_API_URL=
# Optional, with TRANSLATION_PROVIDER=deepl: Google Cloud Translation key for languages DeepL
# does not support (Sinhala). Without it, Sinhala must be translated manually.
GOOGLE_TRANSLATE_API_KEY=

# ---- TripAdvisor reviews (optional) ------------------------------------------
TRIPADVISOR_API_KEY=<your-tripadvisor-api-key>
TRIPADVISOR_LOCATION_ID=23985020

# ---- Initial Super Admin (used by `npm run seed`) ----------------------------
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
# Must satisfy the password policy. Required when seeding in production;
# in development a random password is generated and printed if left empty.
SEED_ADMIN_PASSWORD=<choose-a-strong-admin-password>
